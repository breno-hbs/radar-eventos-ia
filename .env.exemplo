# Copie para .env (ignorado pelo git) e preencha localmente; no CI use GitHub Secrets.
# O radar NÃO lê este arquivo automaticamente: exporte as variáveis no ambiente.

# Segredos: deixe vazio aqui, nunca versione valores reais.
DATABASE_URL=
ANTHROPIC_API_KEY=
TELEGRAM_TOKEN=
# Dado pessoal: deixe vazio aqui.
TELEGRAM_CHAT_ID=

# Fuso IANA usado na exibição (padrão America/Sao_Paulo).
FUSO_HORARIO=America/Sao_Paulo
# Máximo de chamadas ao LLM por execução (mínimo 1).
LIMITE_CHAMADAS_LLM_POR_EXECUCAO=50
# Máximo de páginas de evento lidas no enriquecimento por execução (0 desliga).
LIMITE_PAGINAS_ENRIQUECIMENTO_POR_EXECUCAO=10
# Execuções seguidas sem o evento (com todos os seus calendários lidos) até "não encontrado"
# (mínimo 1; vazio usa o padrão 3).
LIMITE_AUSENCIAS_NAO_ENCONTRADO=
# Tetos de tokens acumulados do classificador por execução (mínimo 1; D13).
LIMITE_TOKENS_ENTRADA_POR_EXECUCAO=200000
LIMITE_TOKENS_SAIDA_POR_EXECUCAO=40000

# Só para os testes de banco: Postgres local cujo nome termina em _teste (o schema é apagado!).
# Nunca aponte para o banco real; DATABASE_URL não é usada como alternativa.
TEST_DATABASE_URL=
